"""Type stub of the LinuxCNC 2.9.4 `hal` module — the part the HAL helpers use
(hal_reader.py, hal_watchdog.py, subroutines/surfacemap/compensation.py;
package 2, Codex R352/R353). `hal` re-exports `_hal` (src/hal/halmodule.cc,
v2.9.4): component("s|s"), its newpin/newparam("sii") → item, getitem("s"),
ready/exit/unready (no args → None), item access by pin name; get_value("s")
→ bool (BIT) / int (S32, U32) / float (FLOAT); set_p("ss") → bool, TRUE ON
FAILURE (`PyBool_FromLong(retval != 0)`); get_info_pins / _params / _signals
→ list of dicts (NAME, VALUE, DIRECTION / DRIVER, TYPE). The HAL_* values
are hal.h's enums (installed /usr/include/linuxcnc/hal.h: BIT 1, FLOAT 2,
S32 3, U32 4, IN 16, OUT 32, IO 48, RO 64, RW 192). Every public name is a
claim the native check (lcnc_iface_check.py) finds on the installed module;
the info-row TypedDicts are stub-only helpers (private)."""
from typing import Final, TypedDict

class _PinInfo(TypedDict):
    NAME: str
    VALUE: bool | int | float | None
    DIRECTION: int
    TYPE: int | None

class _SignalInfo(TypedDict):
    NAME: str
    VALUE: bool | int | float | None
    DRIVER: str | None
    TYPE: int | None

class _ParamInfo(TypedDict):
    NAME: str
    DIRECTION: int
    VALUE: bool | int | float | None

HAL_BIT: Final = 1
HAL_FLOAT: Final = 2
HAL_S32: Final = 3
HAL_U32: Final = 4
HAL_IN: Final = 16
HAL_OUT: Final = 32
HAL_IO: Final = 48
HAL_RO: Final = 64
HAL_RW: Final = 192

class item:
    def get(self) -> bool | int | float: ...
    def set(self, value: object, /) -> None: ...
    def get_type(self) -> int: ...
    def get_dir(self) -> int: ...
    def get_name(self) -> str | None: ...
    def is_pin(self) -> bool: ...

class component:
    def __init__(self, name: str, prefix: str = ..., /) -> None: ...
    def newpin(self, name: str, type: int, dir: int, /) -> item: ...
    def newparam(self, name: str, type: int, dir: int, /) -> item: ...
    def getitem(self, name: str, /) -> item: ...
    def getpins(self) -> dict[str, item]: ...
    def getprefix(self) -> str: ...
    def setprefix(self, prefix: str, /) -> None: ...
    def ready(self) -> None: ...
    def unready(self) -> None: ...
    def exit(self) -> None: ...
    # pin / param access by name: halmodule.cc pyhal_getattro / pyhal_setattro
    # (mapping protocol): the value by the pin's type, any object for BIT
    def __getitem__(self, name: str, /) -> bool | int | float: ...
    def __setitem__(self, name: str, value: object, /) -> None: ...

def get_value(name: str, /) -> bool | int | float: ...
def set_p(name: str, value: str, /) -> bool: ...
# one dict per row, the binding's own shape (Py_BuildValue "{s:s,s:N,...}");
# VALUE / TYPE are None for a type the binding does not decode
def get_info_pins() -> list[_PinInfo]: ...
def get_info_params() -> list[_ParamInfo]: ...
def get_info_signals() -> list[_SignalInfo]: ...
