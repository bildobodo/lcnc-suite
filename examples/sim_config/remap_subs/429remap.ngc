;M429 by remap: kinstype==0 Identity kinematics
; Adapted from LinuxCNC 2.9.4 sample-configs sim/axis/vismach/5axis/
; table-rotary-tilting (GPL v2). lcnc-suite changes: see 428remap.ngc
o<429remap>sub
(WEBUI_SUB=429remap) ;lcnc-suite: preview sub-span marker, silent in task

  #<kinstype> = 0
  #<SWITCHKINS_PIN> = 2  ; motion.analog-out-02 (see 428remap.ngc)

o1 if [#<_task> EQ 1]
o2   if [exists [#<_hal[motion.switchkins-type]>]]
o2   else
       (debug,M429:Missing [RS274NGC]HAL_PIN_VARS=1)
       (debug,STOP)
       M2
o2   endif
o1 endif

   M68  E#<SWITCHKINS_PIN> Q#<kinstype> ; set kinstype value
   M66  E0 L0                           ; force synch
; announce the switch to the lcnc-suite preview parse - comments are
; the one execution-ordered channel the preview canon receives
   (WEBUI_KINSTYPE=0)

o3 if [#<_task> EQ 1]
o4   if [#<_hal[motion.switchkins-type]> NE #<kinstype>]
       (debug,M429:Wrong motion.switchkins-type)
       (debug,or missing hal net to analog-out-02)
       (debug,STOP)
       M2
o4   endif
o3 endif

(WEBUI_SUB_END) ;lcnc-suite: preview sub-span marker
o<429remap>endsub
