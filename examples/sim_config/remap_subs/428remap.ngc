;M428 by remap: kinstype==1 (xyzac TCP-style world kins) (note: sparm=identityfirst)
; Adapted from LinuxCNC 2.9.4 sample-configs sim/axis/vismach/5axis/
; table-rotary-tilting (GPL v2). lcnc-suite changes:
;   - SWITCHKINS_PIN 3 -> 2 (core_sim_5.hal loads motion with num_aio=3,
;     so analog-out-03 does not exist; -00 is coolant, -02 is free)
;   - HAL-pin sanity check hard-fails only under task (#<_task> EQ 1) so
;     a preview parse (no HAL) is not truncated by the debug,STOP branch
o<428remap>sub
  #<kinstype> = 1        ; xyzac world/TCP-style
  #<SWITCHKINS_PIN> = 2  ; motion.analog-out-02 (see header)

o1 if [#<_task> EQ 1]
o2   if [exists [#<_hal[motion.switchkins-type]>]]
o2   else
       (debug,M428:Missing [RS274NGC]HAL_PIN_VARS=1)
       (debug,STOP)
       M2
o2   endif
o1 endif

   M68  E#<SWITCHKINS_PIN> Q#<kinstype> ; set kinstype value
   M66  E0 L0                           ; force synch
; announce the switch to the lcnc-suite preview parse - comments are
; the one execution-ordered channel the preview canon receives
   (WEBUI_KINSTYPE=1)

o3 if [#<_task> EQ 1]
o4   if [#<_hal[motion.switchkins-type]> NE #<kinstype>]
       (debug,M428: Wrong motion.switchkins-type)
       (debug,or missing hal net to analog-out-02)
       (debug,STOP)
       M2
o4   endif
o3 endif

o<428remap>endsub
