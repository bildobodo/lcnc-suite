; this is the wrapper remap to cancel TWP
; Vendored from LinuxCNC master @493926b56c configs/sim/axis/vismach/5axis/
; twp/remap_subs (GPL v2, David Mueller). lcnc-suite change: (WEBUI_KINSTYPE=n)
; marker after the kins switch - the execution-ordered comment channel the
; webui preview canon receives (silent in task).

o<g69remap>sub
(WEBUI_SUB=g69remap CALLER=g69) ;lcnc-suite: preview sub-span marker, silent in task

M66 L0 E0       ; force sync, stop read ahead
M469            ; call the python G69_core code
M68 E3 Q0       ; switch to identity kins
(WEBUI_KINSTYPE=0)
M68 E2 Q0       ; reset twp-state to 'undefined' (0)
G54             ; switch to G54
M66 L0 E0       ; force sync, stop read ahead
(WEBUI_SUB_END) ;lcnc-suite: preview sub-span marker
o<g69remap>endsub
m2
