; this is the wrapper remap to orient the spindle using TCP kinematics G53.6
; Vendored from LinuxCNC master @493926b56c configs/sim/axis/vismach/5axis/
; twp/remap_subs (GPL v2, David Mueller). lcnc-suite change: (WEBUI_KINSTYPE=n)
; markers after each kins switch - the execution-ordered comment channel the
; webui preview canon receives (silent in task). The type-2 marker for the
; final TOOL-kins switch is emitted by remap.py g53x_core (M530).

o<g536remap>sub
(WEBUI_SUB=g536remap) ;lcnc-suite: preview sub-span marker, silent in task

M66 L0 E0                                                   ;force sync, stop read ahead
o100 if [EXISTS [#<P>]]
o100 else
    #<P> = 0                                                ;if no P word has been passed we use the default (0)
o100 endif
M68 E3 Q1                                                   ;switch to tcp kinematic
(WEBUI_KINSTYPE=1)
M66 L0 E0
M530 P#<P>                                                  ;orient the spindle with P word
M66 L0 E0
(WEBUI_SUB_END) ;lcnc-suite: preview sub-span marker
o<g536remap>endsub
m2
