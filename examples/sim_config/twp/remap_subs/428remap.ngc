;M428 by remap: kinstype==0 (IDENTITY kinematics)
; Adapted from LinuxCNC master @493926b56c configs/sim/axis/vismach/5axis/
; twp/remap_subs (GPL v2, David Mueller). lcnc-suite changes:
;   - (WEBUI_KINSTYPE=n) marker after the switch - comments are the one
;     execution-ordered channel the preview canon receives
;   - HAL-pin sanity checks hard-fail only under task (#<_task> EQ 1) so
;     a preview parse (no HAL) is not truncated by the debug,STOP branch;
;     guards are NESTED o-if blocks because RS274 AND does not short-circuit
o<428remap>sub
(WEBUI_SUB=428remap) ;lcnc-suite: preview sub-span marker, silent in task

  #<kinstype> = 0        ; identity
  #<SWITCHKINS_PIN> = 3  ; motion.analog-out-03

o1 if [#<_task> EQ 1]
o2   if [exists [#<_hal[motion.switchkins-type]>]]
o2   else
       (debug,M428:Missing [RS274NGC]HAL_PIN_VARS=1)
       (debug,STOP)
       M2
o2   endif
o1 endif

   M66  E0 L0                           ; force synch
   M68  E#<SWITCHKINS_PIN> Q#<kinstype> ; set kinstype value
   M66  E0 L0                           ; force synch
   (WEBUI_KINSTYPE=0)

o3 if [#<_task> EQ 1]
o4   if [#<_hal[motion.switchkins-type]> NE #<kinstype>]
       (debug,M428: Wrong motion.switchkins-type)
       (debug,or missing hal net to analog-out-03)
       (debug,STOP)
       M2
o4   endif
o3 endif

(WEBUI_SUB_END) ;lcnc-suite: preview sub-span marker
o<428remap>endsub
m2
