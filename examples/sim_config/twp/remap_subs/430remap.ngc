;M430 by remap: kinstype==2 (TOOL kinematics)
; Adapted from LinuxCNC master @493926b56c configs/sim/axis/vismach/5axis/
; twp/remap_subs (GPL v2, David Mueller). lcnc-suite changes:
;   - (WEBUI_KINSTYPE=n) marker after the switch - comments are the one
;     execution-ordered channel the preview canon receives
;   - HAL-pin sanity checks hard-fail only under task (#<_task> EQ 1) so
;     a preview parse (no HAL) is not truncated by the debug,STOP branch;
;     guards are NESTED o-if blocks because RS274 AND does not short-circuit
; NOTE: manual M430 gives the preview NO plane-frame values - only the
; G53.x remaps emit (WEBUI_TWPFRAME=...); a bare M430 span poses with the
; kins pins' current values, which the preview cannot know. The webui
; treats a type-2 span with no frame marker as unchecked, never guessed.
o<430remap>sub
(WEBUI_SUB=430remap CALLER=m430) ;lcnc-suite: preview sub-span marker, silent in task

  #<kinstype> = 2        ; TOOL (tilted work plane)
  #<SWITCHKINS_PIN> = 3  ; motion.analog-out-03

o1 if [#<_task> EQ 1]
o2   if [exists [#<_hal[motion.switchkins-type]>]]
o2   else
       (debug,M430:Missing [RS274NGC]HAL_PIN_VARS=1)
       (debug,STOP)
       M2
o2   endif
o1 endif

   M66  E0 L0                           ; force synch
   M68  E#<SWITCHKINS_PIN> Q#<kinstype> ; set kinstype value
   M66  E0 L0                           ; force synch
   (WEBUI_KINSTYPE=2)

o3 if [#<_task> EQ 1]
o4   if [#<_hal[motion.switchkins-type]> NE #<kinstype>]
       (debug,M430: Wrong motion.switchkins-type)
       (debug,or missing hal net to analog-out-03)
       (debug,STOP)
       M2
o4   endif
o3 endif

; lcnc-suite (2026-08-30): the fixture rides the kins mode. TOOL kinematics
; express positions in the plane frame whose origin g53x_core wrote to
; G59 — select it, so the DRO reads the plane and a touch-off here reaches
; the remap's Plane route (gateway command_policy.touchoff_route: kins 2 +
; G59). The UI only offers this switch after an orient (twpOriented).
G59

(WEBUI_SUB_END) ;lcnc-suite: preview sub-span marker
o<430remap>endsub
m2
