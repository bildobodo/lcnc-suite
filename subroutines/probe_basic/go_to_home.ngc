; Origin: https://github.com/kcjengr/probe_basic
; License: GPL-3.0
; Local modification (lcnc-suite): the upstream version inferred rotary
; letters from the AXIS COUNT ([traj]axes: 4 -> A, 5 -> A C), which sends
; a nonexistent A-word on any 5-axis layout that isn't XYZAC (e.g. XYZBC
; nutating-head machines -> "Bad character 'A'"). Probe each rotary's INI
; section instead: [AXIS_x]MAX_LIMIT exists iff the axis is configured.
; Local modification (lcnc-suite, 2026-09-04): the Z retract is guarded —
; a retract never lowers Z (see the guard below).
o<go_to_home> sub

M73
G90
; lcnc-suite: a retract never lowers Z. #<_abs_z> is the frame a G53 Z word
; addresses — program Z + G92 + G5x + TLO on both sides (interp_namedparams.cc
; NP_ABS_Z, interp_find.cc find_ends G_53). Machine Z0 is the top of travel
; only on machines that home at the top; anywhere else a bare G53 Z0 is a
; descent (TWP sim, 2026-09-04).
o100 if [#<_abs_z> LT 0]
    G53 G0 Z0
o100 endif
G53 G0 X0 Y0

o110 if [EXISTS[#<_ini[axis_a]max_limit>]]
    G53 G0 A0
o110 endif
o120 if [EXISTS[#<_ini[axis_b]max_limit>]]
    G53 G0 B0
o120 endif
o130 if [EXISTS[#<_ini[axis_c]max_limit>]]
    G53 G0 C0
o130 endif

o<go_to_home> endsub

M2
