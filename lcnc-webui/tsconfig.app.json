{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  // machineModel.test.ts is a NODE-side acceptance gate (reads the generated
  // STLs via node:fs) — it can't typecheck under the DOM app config and is
  // typechecked/run by vitest instead. Keep every other test in the app
  // project so vue-tsc still covers them.
  "exclude": ["src/viewer/palette.test.ts", "src/viewer/machineModel.test.ts", "src/viewer/machineDmu160p.test.ts",
              "src/viewer/machineTrsrn.test.ts", "src/viewer/simReplay.corpus.test.ts"]
}
