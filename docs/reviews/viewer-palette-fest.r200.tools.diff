+class TraceTailInodes(unittest.TestCase):
+    """A file is its inode and its first bytes (2026-10-25): a new trace file
+    that takes a removed file's inode number is read from its start."""
+
+    def test_a_reused_inode_with_new_content_is_read_from_the_start(self):
+        from tracetail import TraceTail
+        rec = lambda t, tag: json.dumps({"t_wall_ns": t, "tag": tag, "pad": "x" * 40},
+                                        separators=(",", ":")) + "\n"
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "trace.ndjson")
+            t0 = time.time_ns()
+            with open(path, "w") as f:
+                for k in range(50):
+                    f.write(rec(t0 + k, "old"))
+            tail = TraceTail(0, logs=d)
+            self.assertEqual(len(tail.since(t0)), 50)
+            ino = os.stat(path).st_ino
+            with open(path, "w") as f:           # same inode, new and shorter
+                f.write(rec(t0 + 100, "gcode.publish"))
+            self.assertEqual(os.stat(path).st_ino, ino)
+            self.assertEqual([r["tag"] for r in tail.since(t0 + 100)], ["gcode.publish"])
+            with open(path, "a") as f:           # the same file grows: no record twice
+                f.write(rec(t0 + 101, "next"))
+            self.assertEqual([r["tag"] for r in tail.since(t0 + 100)], ["gcode.publish", "next"])
