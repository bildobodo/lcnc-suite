  "diff": [
   "--- before",
   "+++ after",
   "@@ -5,13 +5,15 @@",
   " # Runs as its own unit (systemd-run --user --unit \u2026); the burners die with it.",
   " set -u",
   " TREE=$1; OUT=$2; REPEAT=$3; BURN=$4; shift 4",
   "+# the ONE heavy lock of the gates, perf_matrix and the native stage (Codex",
   "+# R269), taken through the tree's heavy_lock.py so an OWED LAN return is",
   "+# honoured (Codex R332 A2: a bare `flock` here was blind to it). The script",
   "+# runs itself again under the lock; the lock's descriptor stays with it.",
   "+if [[ -z \"${LCNC_HEAVY_LOCK_HELD:-}\" ]]; then",
   "+  exec python3 -I \"$TREE/scripts/test_support/heavy_lock.py\" --who repro-load --wait 14400 -- \\",
   "+    env LCNC_HEAVY_LOCK_HELD=1 bash \"$0\" \"$TREE\" \"$OUT\" \"$REPEAT\" \"$BURN\" \"$@\"",
   "+fi",
   " cd \"$TREE/lcnc-webui\" || exit 2",
   "-# the ONE heavy lock of the gates, perf_matrix and the native stage (Codex R269)",
   "-LOCK=${LCNC_HEAVY_LOCK:-$HOME/claude-work/live-tier/heavy.lock}",
   "-mkdir -p \"$(dirname \"$LOCK\")\"",
   "-exec 9>>\"$LOCK\"",
   "-flock -w 14400 9 || { echo \"heavy lock held: $(cat \"$LOCK\")\" >&2; exit 4; }",
   "-: > \"$LOCK\"; echo \"repro-load (pid $$, since $(date -Is))\" >> \"$LOCK\"",
   " # another tree's preview on :4173 would serve ITS build (reuseExistingServer)",
   " if ss -ltn | grep -q \":4173 \"; then echo \"4173 busy \u2014 another preview\" >&2; exit 3; fi",
   " pids=()"
  ],
  "check": "LCNC_HEAVY_LOCK=<private> with an owed marker for /run/X: `timeout 4 bash repro-load.sh <tree> <out> 1 0 e2e/none.spec.ts` printed 'repro-load: waiting for the heavy lock \u2014 a LAN return is owed for /run/X \u2026', exit 124 (the timeout), no burner, no out.json"
 }
