            "62: def load_trace_ndjson() -> List[dict]:",
            "63:     \"\"\"Read structured trace.ndjson. Returns events with t_wall_ns.\"\"\"",
            "64:     f = _safe_open(TRACE_PATH)",
            "65:     if f is None:",
            "66:         return []",
            "67:     events = []",
            "68:     with f:",
            "69:         for line in f:",
            "70:             line = line.strip()",
            "71:             if not line:",
            "72:                 continue",
            "73:             try:",
            "74:                 ev = json.loads(line)",
            "75:             except Exception:",
            "76:                 continue",
            "77:             if not isinstance(ev, dict):",
            "78:                 continue",
            "79:             if \"t_wall_ns\" not in ev:",
            "80:                 continue",
            "81:             events.append(ev)",
