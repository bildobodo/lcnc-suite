            "795: def _snapshot_trip(trip_ts_ns: int) -> None:",
            "796:     \"\"\"Write a forensic bundle when a HAL safety trip fires. Runs in a",
            "797:     worker thread (asyncio.to_thread) so it can't block the loop. Best",
            "798:     effort: any failure is logged but doesn't propagate.\"\"\"",
            "799:     base = _trace.log_dir()",
            "800:     if not base:",
            "801:         # No silent scatter: a trip bundle written to cwd/`/tmp` is a lost",
            "802:         # forensic record. Surface the bug instead.",
            "803:         _trace.emit(\"safety.snapshot_no_log_dir\", level=\"error\",",
            "804:                     trip_ts_ns=trip_ts_ns)",
            "805:         return",
            "806:     out_dir = os.path.join(base, f\"trips/{trip_ts_ns}/\")",
            "807:     try:",
            "808:         os.makedirs(out_dir, exist_ok=True)",
            "809:     except Exception as e:",
            "810:         _trace.emit(\"safety.snapshot_mkdir_failed\", level=\"error\",",
            "811:                     out_dir=out_dir, exc=type(e).__name__, msg=str(e))",
            "812:         return",
            "813:     try:",
            "814:         # The bundler is best-effort: 10 s timeout protects against the",
            "815:         # rare case where /tmp is on a slow filesystem (e.g. tmpfs full).",
            "816:         rc = subprocess.run(",
            "817:             [",
            "818:                 \"python3\",",
            "819:                 \"/home/cnc/lcnc-suite/scripts/trace-bundle.py\",",
            "820:                 # Pass the exact trip timestamp: --trip's auto-detect anchors",
            "821:                 # on wd.hb_edge, a best-effort 100 ms poller that misses short",
            "822:                 # pin dips — it once re-bundled the PREVIOUS trip's window",
            "823:                 # because the fresh trip never produced a falling edge.",
            "824:                 \"--trip-ns\", str(trip_ts_ns),",
            "825:                 \"--out\", out_dir,",
            "826:             ],",
            "827:             timeout=10,",
            "828:             capture_output=True,",
            "829:             check=False,",
            "830:         )",
            "831:         _trace.emit(\"safety.trip_snapshot_done\",",
            "832:                     out_dir=out_dir, rc=rc.returncode)",
            "833:     except subprocess.TimeoutExpired:",
            "834:         _trace.emit(\"safety.trip_snapshot_timeout\", level=\"warn\",",
            "835:                     out_dir=out_dir, timeout_s=10)",
            "836:     except Exception as e:",
            "837:         _trace.emit(\"safety.trip_snapshot_failed\", level=\"warn\",",
            "838:                     out_dir=out_dir, exc=type(e).__name__, msg=str(e))",
            "839: ",
