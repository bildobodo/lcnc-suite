            "247:         try:",
            "248:             line = json.dumps(",
            "249:                 {\"t_wall_ns\": rec[\"t_wall_ns\"], \"t_mono_ms\": rec[\"t_mono_ms\"],",
            "250:                  \"proc\": rec[\"proc\"], \"pid\": rec[\"pid\"], \"tag\": tag,",
            "251:                  \"level\": rec[\"level\"], \"msg\": (msg[:200] if msg else \"\"),",
            "252:                  \"truncated\": True},",
            "253:                 separators=(\",\", \":\"),",
            "254:             )",
            "255:         except Exception:",
            "256:             return",
            "257:     try:",
            "258:         # Attach the tag as a record attribute so _CrashFilter can match without",
            "259:         # re-decoding the JSON line on every emit (P0.3).",
            "260:         _logger.info(line, extra={\"_trace_tag\": tag})",
            "261:     except Exception as e:",
            "262:         # One-shot self-report. We cannot recursively call emit() to log",
            "263:         # the logger failure (would infinite-loop), so the only honest",
            "264:         # signal is a single stderr print the first time it happens.",
            "265:         # Silent fallback here was the highest-priority trace gap.",
            "266:         global _logger_failed",
            "267:         if not _logger_failed:",
            "268:             _logger_failed = True",
            "269:             try:",
            "270:                 print(",
            "271:                     f\"[TRACE] logger write failed (further failures silenced): {e}\",",
            "272:                     file=sys.stderr, flush=True,",
            "273:                 )",
            "274:             except Exception:  # noqa: BLE001",
            "275:                 # the LAST fallback is best effort too (Codex R370 VM-I14): a",
            "276:                 # raw, closed stderr made emit() raise here and stopped the",
            "277:                 # shutdown chain that called it before its deadline",
            "278:                 pass"
          ]
        }
