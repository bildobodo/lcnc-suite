            "27: export const HOLD_WATCH_MS = 20;",
            "28: /** The longest gap between two observations of a held press that still",
            "29:  *  counts as an unbroken watch, ms: the watch's own period plus the long",
            "30:  *  tasks measured under the gate's load (50–83 ms) and some room. */",
            "31: export const HOLD_STALL_MS = 150;",
            "32: ",
            "33: export type HoldEnd =",
