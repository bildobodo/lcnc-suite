            "383: # is terminated loudly (terminal + launcher.log + trace.ndjson); any other",
            "384: # holder, or one `ss` cannot name (another uid), aborts the start.",
            "385: _preflight_trace() {  # tag level key=value...",
            "386:   local tag=\"$1\" level=\"$2\"; shift 2",
            "387:   local now_ns fields=\"\" kv k v",
            "388:   now_ns=$(date +%s%N)",
            "389:   for kv in \"$@\"; do",
            "390:     k=\"${kv%%=*}\"; v=\"${kv#*=}\"",
            "391:     v=\"${v//\\\\/\\\\\\\\}\"; v=\"${v//\\\"/\\\\\\\"}\"",
            "392:     fields+=\",\\\"$k\\\":\\\"$v\\\"\"",
            "393:   done",
            "394:   printf '{\"t_wall_ns\":%s,\"t_mono_ms\":0,\"proc\":\"launcher\",\"pid\":%s,\"tag\":\"%s\",\"level\":\"%s\"%s}\\n' \\",
            "395:     \"$now_ns\" \"$$\" \"$tag\" \"$level\" \"$fields\" >> \"$LCNC_RESOLVED_LOG_DIR/trace.ndjson\" 2>/dev/null || true",
            "396: }"
          ]
        },
